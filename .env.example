# CLIMORA Environment Configuration Template
# Copy to .env and fill in if using authenticated or higher-throughput endpoints.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Planetary Computer (Optional, increases rate limits for Landsat / MODIS / DEM STAC access)
# PC_SDK_SUBSCRIPTION_KEY=

# NASA EarthData (Optional, for direct EarthData/CMR bulk downloads)
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# Base Paths (Optional overrides; defaults to relative repository root)
# CLIMORA_DATA_ROOT=./data
# CLIMORA_AOI_PATH=./data/aoi/pune.geojson
