# ==============================================================================
# CLIMORA Production Git Ignore Policy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.pkcs12
*.pfx
*.cert
*.crt
*.csr
id_rsa*
id_ed25519*
aws_credentials
credentials.json
client_secret*.json
*.token
*.auth
*.secret
secrets/
*.private

# ------------------------------------------------------------------------------
# 2. Local Scientific Data Lake & Satellite Rasters
# ------------------------------------------------------------------------------
# Raw satellite scenes, multi-spectral rasters, large arrays remain in S3
*.tif
*.tiff
*.jp2
*.nc
*.hdf
*.part
*.tar
*.tar.gz
*.gz
*.zip
*.7z

data/raw/
data/derived/
data/processed/landsat/
data/processed/sentinel2/
data/processed/modis/
data/processed/worldpop/
data/processed/nasa_power/
data/processed/dem/
data/processed/hev/
data/processed/risk/
data/processed/**/*.csv
data/processed/*.csv

# ------------------------------------------------------------------------------
# 3. Canonical Parquets & Scientific Binaries (Ratified & Stored in S3 Data Lake)
# ------------------------------------------------------------------------------
# Parquet & binary files are strictly preserved in S3 with SHA-256 digests in manifests
*.parquet
*.feather
*.bin
*.npy
*.npz

# ------------------------------------------------------------------------------
# 4. Frontend Dependencies & Build Output
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.wireit/

# ------------------------------------------------------------------------------
# 5. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

.venv/
venv/
ENV/
env/

# ------------------------------------------------------------------------------
# 6. Testing, Linting & Coverage Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 7. IDE, OS, Temporary & Junk Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*.cache
*.bak
*.swp
*.swo
*~
scratch/
temp/
tmp/
txt
